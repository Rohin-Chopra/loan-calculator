# API Gateway endpoint URL
# After deploying Terraform, get this from: terraform output api_gateway_custom_domain
VITE_API_BASE_URL=https://api.loans.rohinchopra.com

# Cognito Configuration
# After deploying Terraform, get these from: terraform output
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
# Can be either the short domain (e.g., "production-loans-auth") or full domain
# The code will automatically construct the full domain if needed
VITE_COGNITO_DOMAIN=
# Optional: AWS region (defaults to ap-southeast-4)
VITE_AWS_REGION=ap-southeast-4
VITE_APP_URL=https://loans.rohinchopra.com
